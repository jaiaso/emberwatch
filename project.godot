; Open this file in Godot 4.5.1 or newer.
config_version=5

[application]
config/name="EMBERWATCH — 灰の砦"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1382
window/size/window_height_override=864
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/use_nearest_filter=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.08, 0.12, 0.12, 1)

[physics]
common/physics_ticks_per_second=20
